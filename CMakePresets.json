{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC (cl) x64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/msvc",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "clang-cl",
      "displayName": "clang-cl x64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/clang-cl",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang-cl" }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "clang-cl-release",
      "configurePreset": "clang-cl",
      "configuration": "Release"
    },
    {
      "name": "clang-cl-debug",
      "configurePreset": "clang-cl",
      "configuration": "Debug"
    }
  ]
}